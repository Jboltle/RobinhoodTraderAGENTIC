# Trader REST API. Two different places this name is read:
#
# 1. BUILD (optional). Baked into the JS as the browser's fetch target.
#    Leave unset for Docker/Railway: the browser uses same-origin /api and
#    `bun server.ts` proxies to the trader. Set only for a static host
#    (Render static site) that cannot proxy — then this must be the trader's
#    public URL, e.g. https://rh-trader.up.railway.app
# 2. RUNTIME on `bun server.ts` (required). The trader base URL this process
#    proxies /api to. Local: http://127.0.0.1:3000
#    Railway private: http://<server-service>.railway.internal:3000
#
# vite dev ignores (2) and uses this file / localhost:3000.
# Sign-in also goes through the trader (POST /api/auth/login), so this is the
# only setting the dashboard needs.
API_URL=http://localhost:3000
