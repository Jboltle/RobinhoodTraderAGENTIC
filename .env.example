# ============================================================
# Discord (Gateway bot)
# ============================================================
DISCORD_BOT_TOKEN=
# Comma-separated guild text channel IDs the bot will listen to. Leave empty to ignore all Discord messages.
DISCORD_ALLOWED_CHANNEL_IDS=
# Comma-separated user IDs whose messages will be treated as callouts.
DISCORD_ALLOWED_AUTHOR_IDS=
# Optional destination channel where allowed source messages are mirrored before parsing/trading.
DISCORD_FORWARD_CHANNEL_ID=
# Comma-separated channel IDs carrying daily trade-recap posts. Stored and
# parsed for the Performance & Metrix dashboard; never traded, never mirrored.
DISCORD_RECAP_CHANNEL_IDS=
# Set true while debugging Discord ingestion. Logs why messages are ignored.
DISCORD_LOG_IGNORED_MESSAGES=false

# ============================================================
# LLM (callout parser)
# ============================================================
# Provider for structured callout extraction. One of: ollama | openai | anthropic
# Startup fails if unset or set to any other value.
LLM_PROVIDER=ollama
# Model name for the selected provider
# (e.g. qwen3:8b for ollama, gpt-4o for openai, claude-sonnet-4-5 for anthropic).
# Temperature 0 is applied for deterministic parsing, except on OpenAI
# reasoning models (o*/gpt-5*), which don't accept a temperature param.
LLM_MODEL=qwen3:8b
# Used when LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
# API keys: required only when the matching cloud provider is selected.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ============================================================
# Trader HTTP server
# ============================================================
TRADER_PORT=3000
# Interface the trader binds to. Every /api route verifies a Supabase JWT, but
# keep 127.0.0.1 outside Docker anyway.
TRADER_HOST=127.0.0.1
# All channels forward to this single endpoint.
TRADER_WEBHOOK_URL=http://localhost:3000/webhook/discord
# Shared secret used to HMAC-sign bot -> trader webhook requests.
# Generate with: openssl rand -hex 32
BOT_TRADER_SECRET=

# Global execution kill-switch: immediate | approval
# immediate submits orders as soon as a callout passes a user's risk checks.
# approval parses/risk-checks/records callouts without submitting, for everyone,
# regardless of each user's own executionMode setting.
TRADE_EXECUTION_MODE=immediate

# ============================================================
# Robinhood Trading MCP
# ============================================================
ROBINHOOD_MCP_URL=https://agent.robinhood.com/mcp/trading
ROBINHOOD_OAUTH_CALLBACK_PORT=8788
# Bind listener host. 0.0.0.0 is friendlier for WSL/Windows browser redirects.
ROBINHOOD_OAUTH_CALLBACK_HOST=0.0.0.0
# Host the browser is redirected to. The redirect URI defaults to
# http://<REDIRECT_HOST>:<CALLBACK_PORT>/oauth/callback, so you usually only
# need to change this (e.g. to your WSL IP from `hostname -I`).
ROBINHOOD_OAUTH_REDIRECT_HOST=127.0.0.1
# Optional full override of the derived redirect URI above.
# ROBINHOOD_OAUTH_REDIRECT_URI=http://127.0.0.1:8788/oauth/callback

# ============================================================
# Risk controls
# ============================================================
# Per-user now, and no longer set here. Each user owns one row in the `settings`
# table, edited from the dashboard's Settings page. The defaults live in
# TradeSettingsSchema (server/src/shared/types.ts) and are the only source.

# ============================================================
# Supabase (auth + database)
# ============================================================
# Local stack: run `npx supabase start` from the repo root and copy the three
# values it prints. This project's ports are shifted off the CLI defaults
# (see supabase/config.toml) so it can run beside another local Supabase.
# Hosted: Project Settings -> API.
SUPABASE_URL=http://127.0.0.1:54331
# Running under docker compose against a LOCAL Supabase? The container can't
# reach 127.0.0.1 on the host, so use http://host.docker.internal:54331 here
# instead. A hosted project needs no such change.
# Publishable key. Used by the BROWSER for auth (login/signup/session) only —
# never for data. Every table is default-deny, so this key reads nothing.
SUPABASE_ANON_KEY=
# Bypasses RLS. Server-side only: it must never reach the client bundle.
SUPABASE_SERVICE_ROLE_KEY=

# Encrypts Robinhood OAuth tokens (AES-256-GCM) before they are written to
# broker_connections, so the database only ever holds ciphertext. Losing this
# key means every user has to reconnect their Robinhood account.
# Any long random string works (the key is derived from it with SHA-256):
# a password-manager-generated password, or `openssl rand -hex 32`.
# On Render this is generated automatically (see render.yaml).
RH_TOKENS_VAULT_KEY=
