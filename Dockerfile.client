# Client: TanStack Start dashboard, built with Vite and served by a small Bun
# static+SSR server (client/server.ts). Same base image as the other services.
FROM oven/bun:1.2.18-slim
WORKDIR /app

COPY client/package.json client/bun.lock ./
# Dev deps included: vite runs the build inside the image.
RUN bun install --frozen-lockfile

COPY --chown=bun:bun client ./

# Baked into the static bundle at build time, so the BROWSER must be able to
# reach both (default: the server's published port, and a host-local Supabase).
# The anon key is public by design; the service-role key must never be passed
# here -- vite.config.ts only exposes SUPABASE_URL and SUPABASE_ANON_KEY.
ARG API_URL=http://localhost:3000
ARG SUPABASE_URL
ARG SUPABASE_ANON_KEY
ENV API_URL=${API_URL}
ENV SUPABASE_URL=${SUPABASE_URL}
ENV SUPABASE_ANON_KEY=${SUPABASE_ANON_KEY}
RUN bun --bun run build

USER bun
EXPOSE 3001
CMD ["bun", "server.ts"]
