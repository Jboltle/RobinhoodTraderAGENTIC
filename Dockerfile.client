# Client: dashboard SPA. Serves dist/client and proxies /api to the trader.
# The trader is a separate service — this image does not run it.
FROM oven/bun:1.2.18-slim
# Slim images omit CA certs; runtime fetch() to an https API_URL then fails.
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /app

COPY client/package.json client/bun.lock ./
# Dev deps included: vite runs the build inside the image.
RUN bun install --frozen-lockfile

COPY --chown=bun:bun client ./

# API_URL is the client's only setting and is read at RUNTIME by server.ts,
# which injects it into the page and proxies /api to it. Nothing is baked into
# the bundle, so no build args are needed here. (Sign-in goes through the
# trader; the client has no Supabase config any more.)
RUN bun --bun run build

USER bun
CMD ["bun", "server.ts"]
