# Client: dashboard SPA. Serves dist/client and proxies /api to the trader.
# The trader is a separate service — this image does not run it.
FROM oven/bun:1.2.18-slim
# Slim images omit CA certs; runtime fetch() to an https API_URL then fails.
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /app

COPY client/package.json client/bun.lock ./
# Dev deps included: vite runs the build inside the image.
RUN bun install --frozen-lockfile

COPY --chown=bun:bun client ./

# Baked into the static bundle. The anon key is public by design; never pass
# SUPABASE_SERVICE_ROLE_KEY — vite.config.ts does not expose it.
# API_URL is optional: when set (public trader URL) Vite bakes it and the
# browser calls that host. When unset, the browser uses same-origin /api and
# server.ts proxies to the runtime API_URL. Do not bake a .railway.internal URL.
# ARG (not ENV): compose --build-arg fills these for RUN. An ENV line
# here would clobber Railway's build-time ENV with an empty ARG.
ARG SUPABASE_URL
ARG SUPABASE_ANON_KEY
RUN bun --bun run build

USER bun
CMD ["bun", "server.ts"]
