# Server: the whole backend in one container -- src/index.ts supervises the
# Fastify trader and the Listener (server/listener, Python gateway capture) as
# a single process tree, so one keep-alive ping on /health keeps both awake.
# See src/index.ts for why they are not separate services.
#
# Compiled with tsc and run as plain JavaScript. `npm run dev` runs the same
# source through tsx instead, which costs ~35 MB of loader per Node process
# plus a ~17 MB esbuild child each -- over 100 MB across the supervisor and
# the trader, so the image pays the compile once at build time. Node rather
# than Bun: Bun's node:tls upgrade leaks every byte postgres.js reads over
# TLS -- see docs/reports/2026-10-20-bun-tls-upgrade-leak.md.
FROM node:24-slim AS build
WORKDIR /app
COPY package.json package-lock.json tsconfig.json ./
RUN npm ci
COPY src ./src
RUN npx tsc -p .

FROM node:24-slim
# Slim images omit CA certs; postgres.js TLS to a remote database then fails
# on the first query and Drizzle reports only "Failed query".
# git: discord.py-self is pinned to a git commit (the pin tracks Discord's
# client fingerprint -- see listener/pyproject.toml), so uv resolves it from
# GitHub and slim images ship without git.
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates git \
  && rm -rf /var/lib/apt/lists/*
# uv is a single static binary; it provisions its own CPython for the Listener,
# so no python base layer or pip is needed.
COPY --from=ghcr.io/astral-sh/uv:0.12.5 /uv /usr/local/bin/uv
ENV UV_LINK_MODE=copy
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --omit=dev

# Everything below runs as the runtime user so uv's managed CPython, cache and
# the venv land in node's home and `uv run` at startup is a no-op sync.
RUN chown node:node /app
USER node

# Listener deps in their own layer: rebuilt only when the lockfile moves.
COPY --chown=node:node listener/pyproject.toml listener/uv.lock listener/
RUN cd listener && uv sync --frozen --no-dev --no-install-project

COPY --chown=node:node --from=build /app/dist ./dist
COPY --chown=node:node listener ./listener
# Install the listener package itself (deps are already in the cached layer).
RUN cd listener && uv sync --frozen --no-dev

# 3000 = /health + /api, 8788 = Robinhood OAuth browser callback
EXPOSE 3000 8788
# No start command is set on the Railway service, so this is what runs. node
# as PID 1 (not npm/sh/tsx wrappers) handles SIGTERM itself in src/index.ts.
CMD ["node", "dist/index.js"]
