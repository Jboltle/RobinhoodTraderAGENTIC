{
  "name": "rh-discord-trader",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Discord-driven Robinhood auto-trader: listens to a channel and executes equity orders via the Robinhood Trading MCP.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "start": "NODE_ENV=production tsx src/index.ts",
    "trader": "tsx src/trader/index.ts",
    "start:trader": "tsx src/trader/index.ts",
    "listener": "cd listener && uv run python -m listener",
    "connect": "tsx src/scripts/rhConnect.ts",
    "auth:reset": "tsx src/scripts/rhResetAuth.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:parse-callout": "tsx src/scripts/parseCalloutPlayground.ts",
    "eval:parse": "tsx src/scripts/parseEval.ts",
    "env:audit": "tsx src/scripts/envAudit.ts",
    "fills:backfill": "tsx src/scripts/backfillFills.ts",
    "typecheck": "tsc -p . --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/etag": "^6.2.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@tanstack/ai": "^0.40.0",
    "@tanstack/ai-anthropic": "^0.16.1",
    "@tanstack/ai-ollama": "^0.8.14",
    "@tanstack/ai-openai": "^0.16.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.44.0",
    "fastify": "^5.8.5",
    "postgres": "^3.4.7",
    "regex": "^6.1.0",
    "tsx": "^4.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "drizzle-kit": "^0.31.0",
    "typescript": "^5.7.2",
    "vitest": "^4.1.9"
  }
}
